{
  "name": "askit-hono",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npx wrangler dev",
    "preview": "npx wrangler dev --remote",
    "deploy": "npx wrangler deploy",
    "tail": "npx wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build:index": "tsx --tsconfig scripts/tsconfig.json scripts/build-ask-index.ts",
    "r2:lifecycle:cache": "wrangler r2 bucket lifecycle set askit-answer-cache --file config/r2-answer-cache-lifecycle.json --force",
    "r2:lifecycle:cache:preview": "wrangler r2 bucket lifecycle set askit-answer-cache-preview --file config/r2-answer-cache-lifecycle.json --force",
    "r2:lifecycle": "npm run r2:lifecycle:cache && npm run r2:lifecycle:cache:preview",
    "vectorize:create": "wrangler vectorize create askit-audrey-tang --dimensions=768 --metric=cosine",
    "vectorize:sync": "tsx --tsconfig scripts/tsconfig.json scripts/vectorize-sync.ts",
    "eval:cag": "tsx --tsconfig scripts/tsconfig.json scripts/eval-cag-models.ts",
    "eval:cag:depth": "tsx --tsconfig scripts/tsconfig.json scripts/eval-cag-depth.ts"
  },
  "dependencies": {
    "fuse.js": "^7.3.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.87.0"
  }
}
