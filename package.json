{
  "name": "askit-hono",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npx wrangler dev",
    "preview": "npx wrangler dev --remote",
    "deploy": "npx wrangler deploy",
    "tail": "npx wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:gateway-package": "npm test -w @au/cf-ai-gateway",
    "pack:gateway": "npm run pack:tarball -w @au/cf-ai-gateway",
    "publish:gateway": "npm publish -w @au/cf-ai-gateway --access public",
    "build:index": "tsx --tsconfig scripts/tsconfig.json scripts/build-ask-index.ts",
    "r2:lifecycle:cache": "wrangler r2 bucket lifecycle set askit-answer-cache --file config/r2-answer-cache-lifecycle.json --force",
    "r2:lifecycle:cache:preview": "wrangler r2 bucket lifecycle set askit-answer-cache-preview --file config/r2-answer-cache-lifecycle.json --force",
    "r2:lifecycle": "npm run r2:lifecycle:cache && npm run r2:lifecycle:cache:preview",
    "vectorize:create": "wrangler vectorize create askit-audrey-tang --dimensions=768 --metric=cosine",
    "vectorize:sync": "tsx --tsconfig scripts/tsconfig.json scripts/vectorize-sync.ts",
    "index:bigram": "tsx --tsconfig scripts/tsconfig.json scripts/build-bigram-index.ts",
    "abuse:db:create": "wrangler d1 create askit-abuse-log",
    "abuse:db:init": "wrangler d1 execute askit-abuse-log --remote --file db/abuse-log-schema.sql --yes",
    "abuse:db:init:local": "wrangler d1 execute askit-abuse-log --local --file db/abuse-log-schema.sql --yes",
    "abuse:report": "tsx --tsconfig scripts/tsconfig.json scripts/abuse-report.ts",
    "abuse:unban": "tsx --tsconfig scripts/tsconfig.json scripts/abuse-unban.ts",
    "memories:extract": "tsx --tsconfig scripts/tsconfig.json scripts/extract-cag-memories.ts",
    "memories:eval": "tsx --tsconfig scripts/tsconfig.json scripts/eval-cag-memories.ts",
    "eval:cag": "tsx --tsconfig scripts/tsconfig.json scripts/eval-cag-models.ts",
    "eval:cag:depth": "tsx --tsconfig scripts/tsconfig.json scripts/eval-cag-depth.ts",
    "skill:mine": "tsx --tsconfig scripts/tsconfig.json scripts/mine-audrey-voice.ts",
    "cf:fugu-provider": "tsx --tsconfig scripts/tsconfig.json scripts/setup-fugu-cloudflare-provider.ts",
    "cf:baseten-verify": "tsx --tsconfig packages/cf-ai-gateway/tsconfig.json packages/cf-ai-gateway/scripts/verify-baseten.ts"
  },
  "dependencies": {
    "@au/cf-ai-gateway": "workspace:*",
    "fuse.js": "^7.3.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.107.0"
  }
}
