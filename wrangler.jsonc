{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "askit-hono",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,

  // LINE_CHANNEL_ACCESS_TOKEN 與 LINE_CHANNEL_SECRET 應透過
  // `wrangler secret put` 設定，不要寫入此檔案。
  //
  // LINE_CHANNEL_ACCESS_TOKEN and LINE_CHANNEL_SECRET should be set via
  // `wrangler secret put`, not in this file.

  "vars": {
    // 可在此放置非機敏的環境變數
    // Place non-sensitive environment variables here
    "ASK_ARCHIVE_BASE_URL": "https://archive.tw",
    // CAG 預設檢索器：'vectorize'（語意，issue #15）或 'archive'（archive.tw 即時搜尋）。
    // 索引尚未建好 / 無 VECTORIZE binding / 查無結果時，程式會自動回退 archive。
    // 亦可用 /cag?retriever=archive 之類的查詢參數逐次覆寫，方便 A/B 比較。
    "CAG_RETRIEVER": "vectorize",
    // 全域生成預算：快取未命中的 /ask、/cag 與 LINE CAG 生成共享同一組 DO 計數器。
    // 以 Gemma 4 26B A4B 典型請求（約 6700 input + 300 output tokens）估算，每次約 <= $0.001。
    "GLOBAL_GENERATION_LIMIT_PER_MINUTE": "30",
    "GLOBAL_GENERATION_LIMIT_PER_DAY": "1000",
    // 異常請求黑名單（issue #27）：同一 IP/Id 在視窗內累積達門檻次數的
    // 超量／過長請求，自動寫入黑名單，之後在任何限流記帳之前直接擋下。
    // 視窗設 "0" = 不限視窗、全期間累計。
    "ABUSE_BLACKLIST_THRESHOLD": "3",
    "ABUSE_COUNT_WINDOW_HOURS": "24",
    // /au 預設模型：GLM-5.2（風格更貼近 Audrey 的對話式、重新框架口吻）。
    // 程式碼 fallback 仍為 Gemma-4；若此值未設或被移除，會自動回退 Gemma。
    "AUDREY_MODEL": "@cf/zai-org/glm-5.2"
  },

  // CPU 上限：避免單次請求異常消耗 Worker CPU；AI/網路等待不計入 CPU time。
  "limits": {
    "cpu_ms": 30000
  },

  // R2：載入預先建好的 Fuse.js 索引（由 `npm run build:index` 產出並上傳）。
  // Bucket 需先建立： npx wrangler r2 bucket create askit-fuse-index-cache
  // 預設索引 key：ask-index/audrey-tang.json
  // ASK_CACHE：對相同問題（且影響答案的參數也相同）的回應做 7 天快取（issue #25）。
  // 區分 /ask、/cag、/webhook 三條路徑（key 前綴 cache/<scope>/<hash>）。
  // Bucket 需先建立： npx wrangler r2 bucket create askit-answer-cache
  //                  npx wrangler r2 bucket create askit-answer-cache-preview
  // 建立後套用 7 天 lifecycle：npm run r2:lifecycle
  // 未綁定時程式會優雅降級（當作未命中、照常生成）。
  "r2_buckets": [
    {
      "binding": "ASK_INDEX",
      "bucket_name": "askit-fuse-index-cache",
      "preview_bucket_name": "askit-fuse-index-cache-preview",
      "remote": true
    },
    {
      "binding": "ASK_CACHE",
      "bucket_name": "askit-answer-cache",
      "preview_bucket_name": "askit-answer-cache-preview",
      "remote": true
    }
  ],

  // Workers AI：/cag/:question 使用此 binding 呼叫 Gemma 4 26B A4B，
  // 並（啟用 Vectorize 後）用 @cf/google/embeddinggemma-300m 將問句嵌入成查詢向量。
  // Workers AI: /cag/:question uses this binding to call Gemma 4 26B A4B.
  "ai": {
    "binding": "AI",
    "remote": true
  },

  // Vectorize：語意檢索索引（issue #15）。索引已建立並回填 2163 筆向量（768/cosine）。
  //   重建：npm run vectorize:create；增量/回填：npm run vectorize:sync
  // 查無結果時 CAG 仍會自動回退 archive.tw 檢索。
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "askit-audrey-tang" }
  ],

  // D1（issue #27）：超量／異常請求追蹤 log（abuse_log）與黑名單（blacklist）。
  // 資料庫已建立（npm run abuse:db:create）；建表／重建 schema：
  //   npm run abuse:db:init          # 遠端
  //   npm run abuse:db:init:local    # 本機 wrangler dev 用
  // 分析報告：npm run abuse:report；解除封鎖：npm run abuse:unban -- <key>
  // 未綁定時程式優雅降級：不寫 log、黑名單視為空。
  // 注意：刻意「不」設 remote: true —— 本機 dev 寫本機 D1（與本機限流 DO 一致），
  // 避免開發測試把雜訊寫進正式環境的 log／黑名單。
  "d1_databases": [
    {
      "binding": "ABUSE_DB",
      "database_name": "askit-abuse-log",
      "database_id": "d87861ce-46d5-4053-afdf-abf5c4a9f61c"
    },
    {
      "binding": "SAYIT_DB",
      "database_name": "sayit-database",
      "database_id": "309347b7-de29-4d0f-b755-55d2638defc9"
    }
  ],
  // KV：CAG 檢索來源快取（1h TTL）。R2 ASK_CACHE 仍負責完整答案快取（7 天）。
  // 建立：npx wrangler kv namespace create CAG_CACHE
  //       npx wrangler kv namespace create CAG_CACHE --preview
  "kv_namespaces": [
    {
      "binding": "CAG_CACHE",
      "id": "a388af13d43f4748837134b8aea36c2a",
      "preview_id": "75c2f64040ef421296f2dc29cb5c8a34"
    }
  ],

  // 防連續濫用：兩層限流（兩層共用同一個 key：line:<userId>、ip:<IPv4> 或 ip6:<IPv6 /64>）。
  //
  // 第一層 RATE_LIMITER —— 內建限流，便宜（非 subrequest、in-memory、零有感延遲）、
  //   per-PoP、eventually consistent、permissive。門檻設很寬（15 次/10 秒），只負責擋
  //   「明顯洪水」：太頻繁就在邊緣直接擋下，根本不碰下游 DO，順手保護單一 DO 實例不被打爆。
  //   period 僅能 10 或 60；門檻刻意遠高於正常用量，避免誤擋守規矩的人。
  //
  // 第二層 RATE_LIMIT_DO —— Durable Object，每個 key 一顆全域唯一實例（idFromName），
  //   單執行緒、強一致，做精準的「同一人 N 秒內最多 1 次」冷卻。內建限流為 per-PoP/最終
  //   一致，擋不住「同一人的下一個請求」（LINE webhook 實測會穿透），故由 DO 當精準把關。
  //
  //   - LINE webhook 以 event.source.userId 為 key（精準對人）。
  //   - /ask、/cag 沒有登入身分，以 cf-connecting-ip 為 key；IPv6 會收斂到 /64 前綴桶。
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 15, "period": 10 }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMIT_DO", "class_name": "RateLimiterDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiterDO"] }
  ],

  "routes": [
    {
      "pattern": "ask.archive.tw",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./public"
  }

  // ─────────────────────────────────────────────────────────────────────
  // 索引建置流程：
  //   1. `npm run build:index` 會用 `wrangler d1 execute sayit-database --remote`
  //      從 sections view 撈出符合 SPEAKER_LIKE（預設 '唐鳳%'）的所有段落。
  //   2. 用 Fuse.createIndex 建出索引，序列化成 JSON。
  //   3. 透過 `wrangler r2 object put --remote` 上傳到上方 R2 bucket。
  //   執行階段 Worker 不會碰 D1，只會從 R2 讀回索引並做 fuzzy 搜尋。
  // ─────────────────────────────────────────────────────────────────────
}
